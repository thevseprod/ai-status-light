# Секреты — НИКОГДА в git
.env

# Рантайм-состояние и логи (метки сторожа, лог отправки)
state/*
!state/.gitkeep

# Системное
.DS_Store

# Приватные правила стрима владельца — не для публики
CLAUDE.md

# Внутренние черновики и дизайн-документы
docs/

# Пользовательские (кастомные) фразы — у каждого свои, не трекаются
phrases/custom/

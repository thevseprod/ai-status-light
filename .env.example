# === Светофор-ДПСник: пример конфигурации ===
# Скопируй этот файл в .env и заполни значения.
# Реальный .env в git НЕ попадает (см. .gitignore).

# Токен бота от @BotFather. ЭТО СЕКРЕТ — никому не показывай, в эфир не выводи.
TELEGRAM_BOT_TOKEN=123456789:PUT-YOUR-FAKE-TOKEN-HERE

# Твой Telegram chat_id (узнаётся через scripts/get_chat_id.sh).
TELEGRAM_CHAT_ID=000000000

# Порог застревания в минутах (через сколько слать «застрял»). Меняй как хочешь.
STUCK_THRESHOLD_MINUTES=5
